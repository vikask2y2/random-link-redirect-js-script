// GL Script

<iframe 
  id="randomFrame" 
  width="100%" 
  height="10" 
  style="border:none;" 
  loading="lazy"
  referrerpolicy="no-referrer"
  allowfullscreen>
</iframe>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    const urls = [
    "https://example.com/",
    "https://example.com/1/",
    "https://example.com/2/",
    "https://example.com/3/"
    ];

    const frame = document.getElementById("randomFrame");
    const refreshInterval = 5000;

    function loadRandomUrl() {
      const randomUrl = urls[Math.floor(Math.random() * urls.length)];
      frame.src = randomUrl;
    }

    loadRandomUrl();
    setInterval(loadRandomUrl, refreshInterval);
  });
</script>
